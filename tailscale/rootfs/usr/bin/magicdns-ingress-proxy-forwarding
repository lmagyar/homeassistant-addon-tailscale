#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Setup DNAT for incoming MagicDNS queries toward ingress dnsmasq proxy
# ==============================================================================

readonly MAGIC_DNS_IPV4="100.100.100.100"
readonly MAGIC_DNS_IPV6="fd7a:115c:a1e0::53"

declare hassio_ipv4_enabled="false"
declare hassio_ipv6_enabled="false"

declare tailscale_address_ipv4
declare tailscale_address_ipv6

function setup_forwarding() {
  local cmd="${1}"
  local sub_cmd="${2}"
  local proto="${3}"
  local ip_version="${4}"
  local address_bits="${5}"
  local from_address="${6}"
  local to_address="${7}"
  local to_port="${8}"
  local name="${9}"

  bashio::log.info "Setting up ${name} for MagicDNS ingress proxy (${proto}, ${ip_version})"
  if ${cmd} -t nat -S PREROUTING \
    | grep -Eq "^-A PREROUTING -d ${from_address//[\[\]]/}/${address_bits} -i hassio -p ${proto} -m ${proto} --dport 53 -j DNAT --to-destination $(sed -r 's/(\[|\])/\\\1/g' <<< "${to_address}"):${to_port}$"
  then
    bashio::log.notice "${name^} is already set for MagicDNS ingress proxy (${proto}, ${ip_version})"
  else
    if ! ${cmd} -t nat "-${sub_cmd}" PREROUTING -d "${from_address//[\[\]]/}" -i hassio -p "${proto}" --dport 53 -j DNAT --to-destination "${to_address}:${to_port}"; then
      bashio::exit.nok "Setting up ${name} for MagicDNS ingress proxy is unsuccessful (${proto}, ${ip_version})"
    fi
  fi
}

function remove_forwarding() {
  local cmd="${1}"
  local ip_version="${2}"
  local address_bits="${3}"
  local from_address="${4}"
  local to_address="${5}"
  local name="${6}"

  local variables
  local proto
  local to_port

  for variables in $( \
    ${cmd} -t nat -S PREROUTING \
    | { grep -E "^-A PREROUTING -d ${from_address//[\[\]]/}/${address_bits} -i hassio -p \S+ -m \S+ --dport 53 -j DNAT --to-destination $(sed -r 's/(\[|\])/\\\1/g' <<< "${to_address}"):\d+$" || true ;} \
    | sed -nr 's/^.*?-p\s(\S+).*?:(\d+)$/\1|\2/p')
  do
    IFS='|' read -r proto to_port <<< "${variables}"
    bashio::log.info "Removing ${name} for MagicDNS ingress proxy (${proto}, ${ip_version})"
    if ! ${cmd} -t nat -D PREROUTING -d "${from_address//[\[\]]/}" -i hassio -p "${proto}" --dport 53 -j DNAT --to-destination "${to_address}:${to_port}"; then
      bashio::log.warning "Removing ${name} for MagicDNS ingress proxy is unsuccessful (${proto}, ${ip_version})"
    fi
  done
}

# hassio's IP availability
if ip address show dev hassio \
  | grep -q 'inet 172.30.32.1/23'
then
  hassio_ipv4_enabled="true"
fi
if ip address show dev hassio \
  | grep -q 'inet6 fd0c:ac1e:2100::1/48'
then
  hassio_ipv6_enabled="true"
fi

# Tailscale's local IP addresses
if bashio::var.equals "${2-}" "forwarding"; then
  tailscale_address_ipv4=$(/opt/tailscale ip -4 2>/dev/null || true)
  tailscale_address_ipv6=$(/opt/tailscale ip -6 2>/dev/null || true)
  if bashio::var.is_empty "${tailscale_address_ipv4}" && bashio::var.is_empty "${tailscale_address_ipv6}"; then
    bashio::exit.nok "Failed to retrieve Tailscale's local address"
  fi
  if ( (bashio::var.true "${hassio_ipv4_enabled}" && bashio::var.is_empty "${tailscale_address_ipv4}") && \
      (bashio::var.false "${hassio_ipv6_enabled}" && bashio::var.has_value "${tailscale_address_ipv6}") ) || \
    ( (bashio::var.false "${hassio_ipv4_enabled}" && bashio::var.has_value "${tailscale_address_ipv4}") && \
      (bashio::var.true "${hassio_ipv6_enabled}" && bashio::var.is_empty "${tailscale_address_ipv6}") )
  then
    bashio::log.fatal "Failed to retrieve any Tailscale local address with matching IP version (v4 or v6) to Home Assistant's internal 'hassio' network"
    if bashio::var.true "${hassio_ipv4_enabled}"; then
      bashio::log.fatal "The internal hassio network is IPv4-only, while the tailnet is IPv6-only, enable IPv6 for docker with 'ha docker options --enable-ipv6=true'"
    else
      # This is only theoretical
      bashio::log.fatal "The internal 'hassio' network is IPv6-only, while the tailnet is IPv4-only"
    fi
    bashio::exit.nok
  fi
fi

case "${1-}-${2-}" in
  setup-drop)
    # Due to forwarding to localhost is not enabled in HA OS, this is de facto a DROP (see martian packets).
    # This temporary trick is needed, because when TS starts, it adds a general ACCEPT FORWARD line in front of existing settings,
    # so we have to drop it during PREROUTING.
    if bashio::var.true "${hassio_ipv4_enabled}"; then
      setup_forwarding "iptables" "I" "udp" "IPv4" "32" "${MAGIC_DNS_IPV4}" "127.0.0.1" "0" "${2}"
      setup_forwarding "iptables" "I" "tcp" "IPv4" "32" "${MAGIC_DNS_IPV4}" "127.0.0.1" "0" "${2}"
    fi
    if bashio::var.true "${hassio_ipv6_enabled}"; then
      setup_forwarding "ip6tables" "I" "udp" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[::1]" "0" "${2}"
      setup_forwarding "ip6tables" "I" "tcp" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[::1]" "0" "${2}"
    fi
    ;;
  setup-forwarding)
    if ! bashio::var.has_value "${3-}"; then
      echo "Port is missing" 1>&2
      echo "Usage: $(basename "$0") setup forwarding port" 1>&2
      exit 1
    fi
    if bashio::var.true "${hassio_ipv4_enabled}" && bashio::var.has_value "${tailscale_address_ipv4}"; then
      setup_forwarding "iptables" "A" "udp" "IPv4" "32" "${MAGIC_DNS_IPV4}" "${tailscale_address_ipv4}" "${3}" "${2}"
      setup_forwarding "iptables" "A" "tcp" "IPv4" "32" "${MAGIC_DNS_IPV4}" "${tailscale_address_ipv4}" "${3}" "${2}"
    fi
    if bashio::var.true "${hassio_ipv6_enabled}" && bashio::var.has_value "${tailscale_address_ipv6}"; then
      setup_forwarding "ip6tables" "A" "udp" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[${tailscale_address_ipv6}]" "${3}" "${2}"
      setup_forwarding "ip6tables" "A" "tcp" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[${tailscale_address_ipv6}]" "${3}" "${2}"
    fi
    ;;
  remove-drop)
    remove_forwarding "iptables" "IPv4" "32" "${MAGIC_DNS_IPV4}" "127.0.0.1" "${2}"
    remove_forwarding "ip6tables" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[::1]" "${2}"
    ;;
  remove-forwarding)
    if bashio::var.has_value "${tailscale_address_ipv4}"; then
      remove_forwarding "iptables" "IPv4" "32" "${MAGIC_DNS_IPV4}" "${tailscale_address_ipv4}" "${2}"
    fi
    if bashio::var.has_value "${tailscale_address_ipv6}"; then
      remove_forwarding "ip6tables" "IPv6" "128" "${MAGIC_DNS_IPV6}" "[${tailscale_address_ipv6}]" "${2}"
    fi
    ;;
  *)
    echo "Usage: $(basename "$0") setup|remove drop|forwarding [port in case of setup forwarding]" 1>&2
    exit 1
    ;;
esac
